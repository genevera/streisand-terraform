# AWS example tfvars. Copy to providers/aws/terraform.tfvars and
# authenticate via `aws configure` (or AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY env vars). Never commit credentials.

region               = "us-east-1"
instance_type        = "t3.micro"
ssh_public_key       = file("/home/YOU/.ssh/id_ed25519.pub")
ssh_private_key_file = "/home/YOU/.ssh/id_ed25519"
ssh_key_name         = "streisand"

# streisand_domain      = "streisand.example.com"
# streisand_admin_email = "you@example.com"