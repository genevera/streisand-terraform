# Google Cloud example tfvars. Copy to providers/google/terraform.tfvars
# and authenticate with `gcloud auth application-default login` (or set
# GOOGLE_APPLICATION_CREDENTIALS). Never commit credentials.

project               = "your-gcp-project-id"
region                = "us-east1"
zone                  = "us-east1-b"
machine_type          = "e2-small"
ssh_public_key        = file("/home/YOU/.ssh/id_ed25519.pub")
ssh_private_key_file  = "/home/YOU/.ssh/id_ed25519"
service_account_email = ""

# streisand_domain      = "streisand.example.com"
# streisand_admin_email = "you@example.com"